# Themed developer shell: Oh My Zsh plugins + Starship prompt + neofetch.
# Sourced from ~/.zshrc via a marked block.

if [[ -n "${UBUNTU_DOTFILES_ZSHRC_LOADED:-}" ]]; then
  return 0
fi
UBUNTU_DOTFILES_ZSHRC_LOADED=1

if [[ -z "${UBUNTU_DOTFILES_ROOT:-}" ]]; then
  UBUNTU_DOTFILES_ROOT="${${(%):-%N}:A:h:h}"
fi

export PATH="${HOME}/.local/bin:${PATH}"
export EDITOR="${EDITOR:-nano}"
export VISUAL="${VISUAL:-${EDITOR}}"
export PAGER="${PAGER:-less}"
export LESS="-R"
export LANG="${LANG:-en_GB.UTF-8}"
export LC_ALL="${LC_ALL:-${LANG}}"

# ---------------------------------------------------------------------------
# Oh My Zsh (plugins / effects). Prompt stays Starship so startup stays sane.
# ---------------------------------------------------------------------------
export ZSH="${ZSH:-${HOME}/.oh-my-zsh}"
ZSH_THEME=""
DISABLE_AUTO_UPDATE="true"
DISABLE_UPDATE_PROMPT="true"
DISABLE_MAGIC_FUNCTIONS="true"
COMPLETION_WAITING_DOTS="true"
HIST_STAMPS="yyyy-mm-dd"

plugins=(git fzf colored-man-pages command-not-found)

if [[ -d "${ZSH}/custom/plugins/zsh-autosuggestions" ]]; then
  plugins+=(zsh-autosuggestions)
fi
if [[ -d "${ZSH}/custom/plugins/zsh-syntax-highlighting" ]]; then
  plugins+=(zsh-syntax-highlighting)
fi

if [[ -s "${ZSH}/oh-my-zsh.sh" ]]; then
  source "${ZSH}/oh-my-zsh.sh"
else
  HISTFILE="${HOME}/.zsh_history"
  HISTSIZE=50000
  SAVEHIST=50000
  setopt HIST_IGNORE_DUPS HIST_IGNORE_SPACE SHARE_HISTORY INTERACTIVE_COMMENTS AUTO_CD
  autoload -Uz compinit
  mkdir -p "${XDG_CACHE_HOME:-${HOME}/.cache}/zsh"
  compinit -d "${XDG_CACHE_HOME:-${HOME}/.cache}/zsh/zcompdump"
fi

ZSH_AUTOSUGGEST_STRATEGY=(history completion)
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#6c7086'

# Apt copies of the same plugins if OMZ custom plugins are missing.
if [[ "${plugins[(Ie)zsh-autosuggestions]}" -eq 0 ]] \
  && [[ -f /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]]; then
  source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
fi

# fzf keybindings if OMZ did not load them
if [[ -z "${FZF_CTRL_T_COMMAND:-}" && -f /usr/share/doc/fzf/examples/key-bindings.zsh ]]; then
  source /usr/share/doc/fzf/examples/key-bindings.zsh
fi
if [[ -f /usr/share/doc/fzf/examples/completion.zsh ]]; then
  source /usr/share/doc/fzf/examples/completion.zsh
fi

# Starship prompt (replaces OMZ themes)
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi

if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
fi

# Syntax highlighting must be last if not loaded as an OMZ plugin.
if [[ "${plugins[(Ie)zsh-syntax-highlighting]}" -eq 0 ]] \
  && [[ -f /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]]; then
  source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
fi

if [[ -f "${UBUNTU_DOTFILES_ROOT}/shell/aliases.sh" ]]; then
  source "${UBUNTU_DOTFILES_ROOT}/shell/aliases.sh"
fi
if [[ -f "${UBUNTU_DOTFILES_ROOT}/shell/functions.sh" ]]; then
  source "${UBUNTU_DOTFILES_ROOT}/shell/functions.sh"
fi

if [[ -f "${HOME}/.zshrc.local" ]]; then
  source "${HOME}/.zshrc.local"
fi

# nvm: lazy-load
export NVM_DIR="${NVM_DIR:-${HOME}/.nvm}"
_ubuntu_dotfiles_nvm_lazy() {
  unset -f nvm node npm npx corepack 2>/dev/null
  [[ -s "${NVM_DIR}/nvm.sh" ]] && . "${NVM_DIR}/nvm.sh"
  [[ -s "${NVM_DIR}/bash_completion" ]] && . "${NVM_DIR}/bash_completion"
}
nvm()  { _ubuntu_dotfiles_nvm_lazy; nvm "$@"; }
node() { _ubuntu_dotfiles_nvm_lazy; node "$@"; }
npm()  { _ubuntu_dotfiles_nvm_lazy; npm "$@"; }
npx()  { _ubuntu_dotfiles_nvm_lazy; npx "$@"; }

# Greeting: neofetch on every new terminal (not inside tmux).
if [[ -o interactive && -z "${UBUNTU_DOTFILES_NO_FETCH:-}" && -z "${TMUX:-}" ]]; then
  if command -v neofetch >/dev/null 2>&1; then
    neofetch
  elif command -v fastfetch >/dev/null 2>&1; then
    fastfetch
  fi
fi

export UBUNTU_DOTFILES_SHELL=1
