# Modular interactive zsh. Starship is the only prompt. No Oh My Zsh theme.
# Sourced from ~/.zshrc via a marked block. Keep this file small.

if [[ -n "${UBUNTU_DOTFILES_ZSHRC_LOADED:-}" ]]; then
  return 0
fi
UBUNTU_DOTFILES_ZSHRC_LOADED=1

if [[ -z "${UBUNTU_DOTFILES_ROOT:-}" ]]; then
  UBUNTU_DOTFILES_ROOT="${HOME}/ubuntu-dotfiles"
  [[ -f "${UBUNTU_DOTFILES_ROOT}/shell/zshrc" ]] || UBUNTU_DOTFILES_ROOT="${HOME}/Ubuntu-Dev"
fi

export PATH="${HOME}/.local/bin:${PATH}"
export EDITOR="${EDITOR:-nano}"
export VISUAL="${VISUAL:-${EDITOR}}"
export PAGER="${PAGER:-less}"
export LESS="-R"
export STARSHIP_CONFIG="${XDG_CONFIG_HOME:-${HOME}/.config}/starship.toml"
if [[ ! -f "${STARSHIP_CONFIG}" ]]; then
  export STARSHIP_CONFIG="${UBUNTU_DOTFILES_ROOT}/terminal/starship.toml"
fi

# Greeting once, before plugins (a plugin error must not hide Fastfetch).
if [[ -f "${UBUNTU_DOTFILES_ROOT}/scripts/terminal-welcome.sh" ]]; then
  # shellcheck disable=SC1091
  . "${UBUNTU_DOTFILES_ROOT}/scripts/terminal-welcome.sh"
fi

if [[ -f "${UBUNTU_DOTFILES_ROOT}/theme/palette.env" ]]; then
  # shellcheck disable=SC1091
  . "${UBUNTU_DOTFILES_ROOT}/theme/palette.env"
fi

if [[ -f "${UBUNTU_DOTFILES_ROOT}/terminal/fzf.env" ]]; then
  # shellcheck disable=SC1091
  . "${UBUNTU_DOTFILES_ROOT}/terminal/fzf.env"
fi

if [[ -f "${UBUNTU_DOTFILES_ROOT}/shell/plugins.zsh" ]]; then
  # shellcheck disable=SC1091
  . "${UBUNTU_DOTFILES_ROOT}/shell/plugins.zsh"
fi

if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi

if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
fi

[[ -f "${UBUNTU_DOTFILES_ROOT}/shell/aliases.sh" ]] && source "${UBUNTU_DOTFILES_ROOT}/shell/aliases.sh"
[[ -f "${UBUNTU_DOTFILES_ROOT}/shell/functions.sh" ]] && source "${UBUNTU_DOTFILES_ROOT}/shell/functions.sh"
[[ -f "${HOME}/.zshrc.local" ]] && source "${HOME}/.zshrc.local"

# nvm is lazy: first node/npm/nvm call loads it. Keeps startup under 100ms when possible.
export NVM_DIR="${NVM_DIR:-${HOME}/.nvm}"
_ubuntu_dotfiles_nvm_lazy() {
  unset -f nvm node npm npx corepack 2>/dev/null
  [[ -s "${NVM_DIR}/nvm.sh" ]] && . "${NVM_DIR}/nvm.sh"
}
nvm()  { _ubuntu_dotfiles_nvm_lazy; nvm "$@"; }
node() { _ubuntu_dotfiles_nvm_lazy; node "$@"; }
npm()  { _ubuntu_dotfiles_nvm_lazy; npm "$@"; }
npx()  { _ubuntu_dotfiles_nvm_lazy; npx "$@"; }

export UBUNTU_DOTFILES_SHELL=1
