# Themed developer shell: Oh My Zsh plugins + Starship + neofetch.
# Sourced from ~/.zshrc via a marked block.

if [[ -n "${UBUNTU_DOTFILES_ZSHRC_LOADED:-}" ]]; then
  return 0
fi
UBUNTU_DOTFILES_ZSHRC_LOADED=1

if [[ -z "${UBUNTU_DOTFILES_ROOT:-}" ]]; then
  UBUNTU_DOTFILES_ROOT="${HOME}/ubuntu-dotfiles"
  [[ -f "${UBUNTU_DOTFILES_ROOT}/shell/zshrc" ]] || UBUNTU_DOTFILES_ROOT="${HOME}/Ubuntu-Dev"
fi

export PATH="${HOME}/.local/bin:${PATH}"
export EDITOR="${EDITOR:-nano}"
export VISUAL="${VISUAL:-${EDITOR}}"
export PAGER="${PAGER:-less}"
export LESS="-R"

# Greeting first so a later plugin error cannot hide it.
if [[ -f "${UBUNTU_DOTFILES_ROOT}/scripts/terminal-welcome.sh" ]]; then
  # shellcheck disable=SC1091
  . "${UBUNTU_DOTFILES_ROOT}/scripts/terminal-welcome.sh"
fi

# ---------------------------------------------------------------------------
# Oh My Zsh plugins. Prompt stays Starship.
# ---------------------------------------------------------------------------
export ZSH="${ZSH:-${HOME}/.oh-my-zsh}"
export STARSHIP_CONFIG="${UBUNTU_DOTFILES_ROOT}/terminal/starship.toml"
if command -v starship >/dev/null 2>&1; then
  ZSH_THEME=""
else
  # Classic Oh My Zsh prompt (shows folder + git) if Starship is missing.
  ZSH_THEME="robbyrussell"
fi
DISABLE_AUTO_UPDATE="true"
DISABLE_UPDATE_PROMPT="true"
DISABLE_MAGIC_FUNCTIONS="true"
COMPLETION_WAITING_DOTS="true"
HIST_STAMPS="yyyy-mm-dd"

plugins=(git fzf colored-man-pages command-not-found)
[[ -d "${ZSH}/custom/plugins/zsh-autosuggestions" ]] && plugins+=(zsh-autosuggestions)
[[ -d "${ZSH}/custom/plugins/zsh-syntax-highlighting" ]] && plugins+=(zsh-syntax-highlighting)

if [[ -s "${ZSH}/oh-my-zsh.sh" ]]; then
  source "${ZSH}/oh-my-zsh.sh" || true
else
  HISTFILE="${HOME}/.zsh_history"
  HISTSIZE=50000
  SAVEHIST=50000
  setopt HIST_IGNORE_DUPS HIST_IGNORE_SPACE SHARE_HISTORY INTERACTIVE_COMMENTS AUTO_CD 2>/dev/null || true
  autoload -Uz compinit 2>/dev/null && compinit -d "${HOME}/.cache/zsh/zcompdump"
fi

ZSH_AUTOSUGGEST_STRATEGY=(history completion)
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#6c7086'

if [[ -f /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]]; then
  source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
fi
if [[ -f /usr/share/doc/fzf/examples/key-bindings.zsh ]]; then
  source /usr/share/doc/fzf/examples/key-bindings.zsh
fi

if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
fi

# Highlighting last
if [[ -f "${ZSH}/custom/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]]; then
  source "${ZSH}/custom/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
elif [[ -f /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]]; then
  source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
fi

[[ -f "${UBUNTU_DOTFILES_ROOT}/shell/aliases.sh" ]] && source "${UBUNTU_DOTFILES_ROOT}/shell/aliases.sh"
[[ -f "${UBUNTU_DOTFILES_ROOT}/shell/functions.sh" ]] && source "${UBUNTU_DOTFILES_ROOT}/shell/functions.sh"
[[ -f "${HOME}/.zshrc.local" ]] && source "${HOME}/.zshrc.local"

export NVM_DIR="${NVM_DIR:-${HOME}/.nvm}"
_ubuntu_dotfiles_nvm_lazy() {
  unset -f nvm node npm npx corepack 2>/dev/null
  [[ -s "${NVM_DIR}/nvm.sh" ]] && . "${NVM_DIR}/nvm.sh"
}
nvm()  { _ubuntu_dotfiles_nvm_lazy; nvm "$@"; }
node() { _ubuntu_dotfiles_nvm_lazy; node "$@"; }
npm()  { _ubuntu_dotfiles_nvm_lazy; npm "$@"; }
npx()  { _ubuntu_dotfiles_nvm_lazy; npx "$@"; }

export UBUNTU_DOTFILES_SHELL=1
