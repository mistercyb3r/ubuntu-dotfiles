# Keep shell scripts and configs with LF so they run correctly on Ubuntu
# even when this repository is edited on Windows.
* text=auto eol=lf

*.sh     text eol=lf
*.zsh    text eol=lf
*.zshrc  text eol=lf
*.bash   text eol=lf
*.toml   text eol=lf
*.conf   text eol=lf
*.md     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.json   text eol=lf
*.gitignore text eol=lf
*.example text eol=lf

*.png    binary
*.jpg    binary
*.ico    binary
