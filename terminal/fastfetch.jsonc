{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "ubuntu",
    "color": {
      "1": "magenta",
      "2": "white"
    },
    "padding": {
      "top": 1,
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "magenta",
      "title": "cyan"
    },
    "brightColor": true
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "cyan",
        "at": "white",
        "host": "magenta"
      }
    },
    "separator",
    {
      "type": "os",
      "key": "os"
    },
    {
      "type": "host",
      "key": "host"
    },
    {
      "type": "kernel",
      "key": "kernel"
    },
    {
      "type": "uptime",
      "key": "uptime"
    },
    {
      "type": "packages",
      "key": "pkgs"
    },
    {
      "type": "shell",
      "key": "shell"
    },
    {
      "type": "terminal",
      "key": "term"
    },
    {
      "type": "de",
      "key": "de"
    },
    {
      "type": "cpu",
      "key": "cpu"
    },
    {
      "type": "memory",
      "key": "memory"
    },
    {
      "type": "disk",
      "key": "disk",
      "folders": "/"
    },
    {
      "type": "battery",
      "key": "battery"
    },
    "break",
    "colors"
  ]
}
