{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "ubuntu_small",
    "color": {
      "1": "cyan",
      "2": "blue"
    },
    "padding": {
      "top": 1,
      "right": 2
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "cyan",
      "title": "magenta"
    },
    "brightColor": false,
    "keyWidth": 10
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "magenta",
        "at": "white",
        "host": "cyan"
      }
    },
    "separator",
    { "type": "os", "key": "os" },
    { "type": "host", "key": "host" },
    { "type": "kernel", "key": "kernel" },
    { "type": "uptime", "key": "uptime" },
    { "type": "packages", "key": "pkgs" },
    { "type": "shell", "key": "shell" },
    { "type": "terminal", "key": "term" },
    { "type": "de", "key": "de" },
    { "type": "wm", "key": "wm" },
    { "type": "cpu", "key": "cpu" },
    { "type": "gpu", "key": "gpu", "detectionMethod": "auto" },
    { "type": "memory", "key": "memory" },
    { "type": "disk", "key": "disk", "folders": "/" },
    { "type": "battery", "key": "battery" },
    { "type": "localip", "key": "lan", "showIpv6": false, "compact": true },
    {
      "type": "command",
      "key": "tailscale",
      "text": "tailscale ip -4 2>/dev/null || true",
      "shell": "/bin/sh"
    },
    "break",
    "colors"
  ]
}
