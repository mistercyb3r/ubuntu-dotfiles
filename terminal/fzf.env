# fzf colours and previews. Sourced from shell/zshrc.
# Palette: theme/palette.md

export FZF_DEFAULT_OPTS="
  --height=40%
  --layout=reverse
  --border=rounded
  --info=inline
  --pointer='>'
  --marker='+'
  --color=bg:#0b0e14,bg+:#161821,fg:#c0caf5,fg+:#c0caf5
  --color=hl:#7dcfff,hl+:#bb9af7,info:#565f89,prompt:#7dcfff
  --color=pointer:#7dcfff,marker:#9ece6a,spinner:#bb9af7,header:#565f89
  --color=border:#565f89
"

if command -v fd >/dev/null 2>&1; then
  export FZF_DEFAULT_COMMAND='fd --hidden --follow --exclude .git'
  export FZF_CTRL_T_COMMAND="${FZF_DEFAULT_COMMAND}"
elif command -v fdfind >/dev/null 2>&1; then
  export FZF_DEFAULT_COMMAND='fdfind --hidden --follow --exclude .git'
  export FZF_CTRL_T_COMMAND="${FZF_DEFAULT_COMMAND}"
fi

_ff_preview='bat --style=numbers --color=always --line-range :200 {} 2>/dev/null || batcat --style=numbers --color=always --line-range :200 {} 2>/dev/null || head -n 80 {}'
export FZF_CTRL_T_OPTS="--preview '${_ff_preview}' --preview-window=right:50%:wrap"
export FZF_CTRL_R_OPTS="--preview 'echo {}' --preview-window=down:3:hidden:wrap --bind '?:toggle-preview'"
unset _ff_preview
